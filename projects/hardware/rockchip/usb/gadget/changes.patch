+// A host-role DWC3 has no UDC. Keep monitoring FFS, but do not repeatedly
+// attempt a bind that the kernel cannot satisfy. A later device role is
+// still eligible once its UDC has actually registered.
+static bool isUdcAvailable(const std::string& gadget) {
+    return access(("/sys/class/udc/" + gadget).c_str(), F_OK) == 0;
