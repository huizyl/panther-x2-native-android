+  void enqueue_legacy_scan_enable() {
+    le_scanning_interface_->EnqueueCommand(
+        LeSetScanEnableBuilder::Create(Enable::ENABLED, Enable::DISABLED),
+        module_handler_->BindOnceOn(this, &impl::on_legacy_scan_enable_complete, legacy_scan_generation_));
+  }
+
+  void retry_legacy_scan(uint64_t generation) {
+    if (generation != legacy_scan_generation_ || !is_scanning_ || paused_) return;
+    enqueue_legacy_scan_enable();
+  }
+
+  void on_legacy_scan_enable_complete(uint64_t generation, CommandCompleteView view) {
+    auto status_view = LeSetScanEnableCompleteView::Create(view);
+    ASSERT(status_view.IsValid());
+    if (generation != legacy_scan_generation_ || !is_scanning_ || paused_) return;
+    const auto status = status_view.GetStatus();
+    if (status == ErrorCode::SUCCESS) {
+      legacy_scan_retry_alarm_->Cancel();
+      legacy_scan_busy_retries_ = 0;
+      return;
+    }
+    // Older dual-mode controllers reject LE scan enable during classic inquiry.
+    // Keep the requested scan alive until inquiry finishes; cancellation/pause
+    // invalidates queued callbacks and alarms so they cannot restart a stopped scan.
+    if (status == ErrorCode::COMMAND_DISALLOWED) {
+      if (legacy_scan_busy_retries_++ < kLegacyScanBusyMaxRetries) {
+        LOG_WARN("Legacy LE scan temporarily disallowed; retry %u/%u",
+                 legacy_scan_busy_retries_, kLegacyScanBusyMaxRetries);
+        // impl owns the alarm and cancels/destroys it before module teardown.
+        legacy_scan_retry_alarm_->Schedule(
+            common::BindOnce(&impl::retry_legacy_scan, common::Unretained(this), generation),
+            std::chrono::milliseconds(500));
+      } else {
+        LOG_ERROR("Legacy LE scan busy retry limit reached");
+        is_scanning_ = false;
+        scan_on_resume_ = false;
+        if (address_manager_registered_) {
+          le_address_manager_->Unregister(this);
+          address_manager_registered_ = false;
+        }
+        ++legacy_scan_generation_;
+        scanning_callbacks_->OnTimeout();
+      }
+      return;
+    }
+    ASSERT_LOG(status == ErrorCode::SUCCESS, "Receive set scan enable with error code %s",
+               ErrorCodeText(status).c_str());
+  }
