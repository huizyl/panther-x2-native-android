# Panther X2: Android 14, RK3566, one virtual display and Mali-G52.
CONFIG_DRM_ROCKCHIP=y
CONFIG_DRM_ROCKCHIP_VVOP=y
# CONFIG_ROCKCHIP_VOP is not set
# CONFIG_ROCKCHIP_VOP2 is not set
CONFIG_MALI_BIFROST=y
# CONFIG_MALI400 is not set
# CONFIG_MALI_MIDGARD is not set
CONFIG_REGULATOR_FAN53555=y
CONFIG_REGULATOR_RK808=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ASHMEM=y
CONFIG_PSI=y
CONFIG_REALTEK_PHY=y
# CONFIG_DEBUG_INFO_DWARF4 is not set
CONFIG_DEBUG_INFO_NONE=y
